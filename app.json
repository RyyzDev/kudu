{
  "expo": {
    "name": "KUDU",
    "slug": "kudu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kudu-icon.jpg",
    "scheme": "kudu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kudu-icon.jpg",
      "bundleIdentifier": "com.ryyzdev.kudu"
    },
    "android": {
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "backgroundColor": "#ffde59",
        "foregroundImage": "./assets/images/kudu-icon.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ryyzdev.kudu"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/kudu-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffde59",
          "image": "./assets/images/kudu-icon.jpg",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "jsEngine": "hermes"
          },
          "ios": {
            "jsEngine": "hermes"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0a75e80-fa9a-4614-b298-ddae65563894"
      }
    }
  }
}
